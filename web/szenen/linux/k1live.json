   "sicht": {
    "de": "Verzeichnisbaum, den die Programme sehen: /\nlesen und schreiben wie auf einer Platte",
    "en": "directory tree the programs see: /\nread and write as on a disk",
    "es": "árbol de directorios que ven los programas: /\nleer y escribir como en un disco",
    "zh": "程序看到的目录树：/\n像在磁盘上一样读写",
    "fr": "arborescence vue par les programmes : /\nlire et écrire comme sur un disque",
    "tr": "programların gördüğü dizin ağacı: /\ndiskteki gibi okuma ve yazma"
   },
   "ram": {
    "de": "obere Schicht im Arbeitsspeicher (tmpfs)\nnimmt alle Änderungen auf, ist beim Ausschalten weg",
    "en": "upper layer in memory (tmpfs)\ntakes all changes, gone at power-off",
    "es": "capa superior en la memoria (tmpfs)\nrecoge todos los cambios, desaparece al apagar",
    "zh": "内存中的上层（tmpfs）\n接收所有更改，关机后消失",
    "fr": "couche supérieure en mémoire (tmpfs)\nreçoit toutes les modifications, disparaît à l’arrêt",
    "tr": "bellekteki üst katman (tmpfs)\ntüm değişiklikleri alır, kapatınca silinir"
   },
   "sq": {
    "de": "untere Schicht: komprimiertes Abbild (squashfs)\ndas System vom Stick, nur lesbar",
    "en": "lower layer: compressed image (squashfs)\nthe system from the stick, read only",
    "es": "capa inferior: imagen comprimida (squashfs)\nel sistema de la memoria, solo lectura",
    "zh": "下层：压缩映像（squashfs）\n来自 U 盘的系统，只读",
    "fr": "couche inférieure : image compressée (squashfs)\nle système de la clé, lecture seule",
    "tr": "alt katman: sıkıştırılmış kalıp (squashfs)\nbellekteki sistem, yalnızca okunur"
   },
   "stick": {
    "de": "USB-Stick",
    "en": "USB stick",
    "es": "memoria USB",
    "zh": "U 盘",
    "fr": "clé USB",
    "tr": "USB bellek"
   },
   "ssd": {
