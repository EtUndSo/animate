    "zh": "安装",
    "fr": "installation",
    "tr": "kurma"
   },
   "entf": {
    "de": "Entfernen",
    "en": "removing",
    "es": "quitar",
    "zh": "删除",
    "fr": "suppression",
    "tr": "kaldırma"
   },
   "b1": {
    "de": "vor dem Auspacken",
    "en": "before unpacking",
    "es": "antes de desempaquetar",
    "zh": "解包之前",
    "fr": "avant le dépaquetage",
    "tr": "açmadan önce"
   },
   "b2": {
    "de": "Dateien auspacken,\nin paket.list\neintragen",
    "en": "unpack files,\nrecord in\npackage.list",
    "es": "desempaquetar,\nanotar en\npaquete.list",
    "zh": "解包文件，\n记入 软件包.list",
    "fr": "dépaqueter,\nnoter dans\npaquet.list",
    "tr": "dosyaları aç,\npaket.list'e\nyaz"
   },
   "b3": {
    "de": "einrichten, etwa einen\nDienst anmelden",
    "en": "set up, e.g. register\na service",
    "es": "configurar, p. ej.\nregistrar un servicio",
    "zh": "进行设置，\n例如注册服务",
    "fr": "configurer, p. ex.\ninscrire un service",
    "tr": "kurulum, ör. bir\nhizmeti kaydetmek"
   },
   "b4": {
    "de": "etwa den Dienst\nanhalten",
    "en": "e.g. stop\nthe service",
    "es": "p. ej. detener\nel servicio",
    "zh": "例如停止服务",
    "fr": "p. ex. arrêter\nle service",
    "tr": "ör. hizmeti\ndurdurmak"
   },
   "b5": {
    "de": "Dateien aus\npaket.list löschen;\nKonfigurations-\ndateien bleiben",
    "en": "delete files in\npackage.list;\nconfiguration\nfiles stay",
    "es": "borrar archivos\nde paquete.list;\nla configuración\nqueda",
    "zh": "删除 软件包.list\n中的文件；\n配置文件保留",
    "fr": "supprimer les\nfichiers de\npaquet.list ; la\nconfiguration reste",
    "tr": "paket.list'teki\ndosyaları sil;\nyapılandırma\ndosyaları kalır"
   },
   "b6": {
    "de": "nach dem Löschen",
    "en": "after deleting",
    "es": "después de borrar",
    "zh": "删除之后",
    "fr": "après la suppression",
    "tr": "sildikten sonra"
   }
