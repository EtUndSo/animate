    "id": "o1",
    "type": "Terminal",
    "props": {
     "text": "#!/bin/bash\n# sicherung.sh: packt ein Verzeichnis in ein Archiv mit\n\\e[90m↪\\e[0m dem Datum im Namen\n#   Aufruf:      sicherung.sh QUELLE ZIEL\n#   Beispiel:    sicherung.sh fotos sicherungen\n#   Exit-Status: 0 Sicherung angelegt, 1 Fehler, 2\n\\e[90m↪\\e[0m falscher Aufruf\n\n# --- Einstellungen ---\nset -u\nset -o pipefail\n\nprogramm=$(basename \"$0\")\n\n# --- Funktionen ---\nfehler() {\n    echo \"$programm: $1\" >&2\n    exit 1\n}\n\n# --- Argumente prüfen ---\nif [ $# -ne 2 ]; then\n    echo \"Aufruf: $programm QUELLE ZIEL\" >&2\n    exit 2\nfi\nquelle=$1\nziel=$2\n[ -d \"$quelle\" ] || fehler \"$quelle ist kein Verzeichnis\"\n[ -d \"$ziel\" ] || fehler \"$ziel ist kein Verzeichnis\"\narchiv=\"$ziel/sicherung_$(date +%F).tar.gz\"\nif [ -e \"$archiv\" ]; then\n    fehler \"$archiv gibt es schon\"\nfi\n\n# --- Aufräumen vorbereiten ---\ntmp=$(mktemp -p \"$ziel\" .sicherung.XXXXXX) || fehler\n\\e[90m↪\\e[0m \"keine Zwischendatei in $ziel\"\ntrap 'rm -f \"$tmp\"' EXIT\n\n# --- Hauptteil ---\ntar -czf \"$tmp\" -C \"$quelle\" . || fehler \"tar ist\n\\e[90m↪\\e[0m gescheitert\"\nmv \"$tmp\" \"$archiv\" || fehler \"kann $archiv nicht anlegen\"\necho \"Gesichert: $archiv\"\nexit 0",
     "cols": 58,
