  "strings": {
   "shell": {
    "de": "Shell",
    "en": "shell",
    "es": "shell",
    "zh": "Shell",
    "fr": "shell",
    "tr": "kabuk"
   },
   "kernel": {
    "de": "Kernel",
    "en": "kernel",
    "es": "kernel",
    "zh": "内核",
    "fr": "noyau",
    "tr": "çekirdek"
   },
   "rechte": {
    "de": "Rechte",
    "en": "permissions",
    "es": "permisos",
    "zh": "权限",
    "fr": "droits",
    "tr": "izinler"
   },
   "skript": {
    "de": "kein Maschinenprogramm,\nsondern ein Skript",
    "en": "not a machine program\nbut a script",
    "es": "no es un programa máquina,\nsino un script",
    "zh": "不是机器程序，\n而是脚本",
    "fr": "pas un programme machine,\nmais un script",
    "tr": "makine programı değil,\nbir betik"
   },
   "neu": {
    "de": "neuer Prozess",
    "en": "new process",
    "es": "proceso nuevo",
    "zh": "新进程",
    "fr": "nouveau processus",
    "tr": "yeni süreç"
   },
   "eingef": {
    "de": "neu eingefügt",
    "en": "newly inserted",
    "es": "insertado",
    "zh": "新插入",
    "fr": "inséré",
    "tr": "yeni eklendi"
   },
   "l1": {
    "de": "Die Shell bittet den Kernel, ./wer.sh zu starten.",
    "en": "The shell asks the kernel to start ./wer.sh.",
    "es": "La shell pide al kernel que inicie ./wer.sh.",
    "zh": "shell 请求内核启动 ./wer.sh。",
    "fr": "Le shell demande au noyau de lancer ./wer.sh.",
    "tr": "Kabuk çekirdekten ./wer.sh'yi başlatmasını ister."
   },
   "l2": {
    "de": "Der Kernel prüft das Ausführungsrecht x.",
    "en": "The kernel checks the execute permission x.",
    "es": "El kernel comprueba el permiso de ejecución x.",
    "zh": "内核检查执行权限 x。",
    "fr": "Le noyau vérifie le droit d'exécution x.",
    "tr": "Çekirdek çalıştırma iznini (x) denetler."
   },
   "l3": {
    "de": "Er liest die ersten Bytes der Datei: #!/bin/bash.",
    "en": "It reads the first bytes of the file: #!/bin/bash.",
    "es": "Lee los primeros bytes del archivo: #!/bin/bash.",
    "zh": "它读取文件开头的字节：#!/bin/bash。",
    "fr": "Il lit les premiers octets du fichier : #!/bin/bash.",
    "tr": "Dosyanın ilk baytlarını okur: #!/bin/bash."
   },
   "l4": {
    "de": "Er startet stattdessen /bin/bash mit dieser Argumentliste.",
    "en": "Instead it starts /bin/bash with this argument list.",
    "es": "En su lugar inicia /bin/bash con esta lista de argumentos.",
    "zh": "它改为用这个参数列表启动 /bin/bash。",
    "fr": "À la place, il lance /bin/bash avec cette liste d'arguments.",
    "tr": "Bunun yerine /bin/bash'i bu argüman listesiyle başlatır."
   },
   "l5": {
    "de": "Die bash öffnet ./wer.sh zum Lesen (Leserecht r).",
    "en": "bash opens ./wer.sh for reading (read permission r).",
    "es": "bash abre ./wer.sh para leerlo (permiso de lectura r).",
    "zh": "bash 打开 ./wer.sh 来读取（读权限 r）。",
    "fr": "bash ouvre ./wer.sh en lecture (droit de lecture r).",
    "tr": "bash, ./wer.sh'yi okumak için açar (okuma izni r)."
   },
   "ps": {
    "de": "ps zeigt:",
    "en": "ps shows:",
    "es": "ps muestra:",
    "zh": "ps 显示：",
    "fr": "ps affiche :",
    "tr": "ps gösterir:"
   }
  },
  "drawOrder": "creation"
 }
