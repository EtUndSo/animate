    "tr": "hangi program ve bittiğinde\nne yapılacak"
   },
   "rolle2": {
    "de": "zu welchem Zustand des Systems\ngehöre ich",
    "en": "which state of the system\ndo I belong to",
    "es": "a qué estado del sistema\npertenezco",
    "zh": "我属于系统的\n哪个状态",
    "fr": "à quel état du système\nj'appartiens",
    "tr": "sistemin hangi durumuna\naitim"
   }
