  "strings": {
   "f1": {
    "de": "Strebt a_n nicht gegen 0?",
    "en": "Does a_n not tend to 0?",
    "es": "¿a_n no tiende a 0?",
    "zh": "a_n 不趋于 0？"
   },
   "e1": {
    "de": "divergent",
    "en": "divergent",
    "es": "divergente",
    "zh": "发散"
   },
   "f2": {
    "de": "Teilsummen als Formel?\n(geometrisch, Teleskop)",
    "en": "Partial sums in closed form?\n(geometric, telescoping)",
    "es": "¿Sumas parciales con fórmula?\n(geométrica, telescópica)",
    "zh": "部分和有闭式？\n（几何、裂项）"
   },
   "e2": {
    "de": "Grenzwert ausrechnen",
    "en": "compute the limit",
    "es": "calcular el límite",
    "zh": "直接求极限"
   },
   "f3": {
    "de": "Wechselnde Vorzeichen,\n|a_n| fällt monoton gegen 0?",
    "en": "Alternating signs,\n|a_n| decreases to 0?",
    "es": "¿Signos alternos,\n|a_n| decrece a 0?",
    "zh": "符号交替，\n|a_n| 单调减到 0？"
   },
   "e3": {
    "de": "Leibniz: konvergent\nabsolut? weiter mit |a_n|",
    "en": "Leibniz: convergent\nabsolutely? go on with |a_n|",
    "es": "Leibniz: convergente\n¿absoluta? seguir con |a_n|",
    "zh": "莱布尼茨：收敛\n绝对收敛？对 |a_n| 继续"
   },
   "f4": {
    "de": "Fakultäten, q^n, Potenzen (…)^n?",
    "en": "Factorials, q^n, powers (…)^n?",
    "es": "¿Factoriales, q^n, potencias (…)^n?",
    "zh": "含阶乘、q^n、幂 (…)^n？"
   },
   "e4": {
    "de": "Quotient oder Wurzel\nα < 1 absolut konvergent\nα > 1 divergent\nα = 1 weiter nach unten",
    "en": "ratio or root\nα < 1 absolutely convergent\nα > 1 divergent\nα = 1 go further down",
    "es": "cociente o raíz\nα < 1 absolutamente conv.\nα > 1 divergente\nα = 1 seguir abajo",
    "zh": "比值或根值\nα < 1 绝对收敛\nα > 1 发散\nα = 1 继续向下"
   },
   "f5": {
    "de": "Nur Potenzen von n?\n(Brüche, Wurzeln)",
    "en": "Only powers of n?\n(fractions, roots)",
    "es": "¿Solo potencias de n?\n(fracciones, raíces)",
    "zh": "只含 n 的幂？\n（分式、根式）"
   },
   "e5": {
    "de": "Vergleich mit Σ 1/n^s",
    "en": "comparison with Σ 1/n^s",
    "es": "comparación con Σ 1/n^s",
    "zh": "与 Σ 1/n^s 比较"
   },
   "f6": {
    "de": "Monoton fallend, mit log n?",
    "en": "Decreasing, with log n?",
    "es": "¿Decreciente, con log n?",
    "zh": "单调递减，含 log n？"
   },
   "e6": {
    "de": "Verdichtung",
    "en": "condensation",
    "es": "condensación",
    "zh": "凝聚判别法"
   },
