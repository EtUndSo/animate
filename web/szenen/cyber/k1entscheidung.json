  "strings": {
   "q1": {
    "de": "Gehört das System dir, und sind\nkeine Daten anderer betroffen?",
    "en": "Is the system yours, and is no one\nelse's data involved?",
    "es": "¿Es tuyo el sistema y no afecta\na datos de otras personas?",
    "zh": "系统属于你，\n且不涉及他人数据？"
   },
   "q2": {
    "de": "Hast du eine ausdrückliche, schriftliche\nErlaubnis des Verfügungsberechtigten,\nund liegt der Test in ihrem Umfang?",
    "en": "Do you have explicit written permission\nfrom the person entitled to decide,\nand is the test within its scope?",
    "es": "¿Tienes permiso expreso y por escrito\nde quien tiene la facultad de decidir,\ny la prueba entra en su alcance?",
    "zh": "你是否有处置权人的\n明确书面许可，\n且测试在许可范围内？"
   },
   "q3": {
    "de": "Ist es eine Lernplattform, deren\nRegeln genau diesen Test erlauben?",
    "en": "Is it a training platform whose rules\nallow exactly this test?",
    "es": "¿Es una plataforma de práctica cuyas\nnormas permiten justo esta prueba?",
    "zh": "这是规则恰好允许\n此项测试的练习平台吗？"
   },
   "j1": {
    "de": "erlaubt",
    "en": "allowed",
    "es": "permitido",
    "zh": "允许"
   },
   "j2": {
    "de": "erlaubt, nur im\nvereinbarten Umfang",
    "en": "allowed, only within\nthe agreed scope",
    "es": "permitido, solo dentro\ndel alcance acordado",
    "zh": "允许，仅限\n约定范围"
   },
   "j3": {
    "de": "erlaubt, nur innerhalb\nder Regeln",
